{
    "name": "tex-core",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.7.0",
    "engines": {
        "node": "26.5.0",
        "pnpm": "11.7.0"
    },
    "scripts": {
        "audit:ci": "scripts/audit-ci-policy.sh",
        "audit:packages": "scripts/audit-package-contents.sh",
        "audit:repository": "scripts/audit-repository.sh",
        "audit:repository:clean": "scripts/audit-repository.sh --clean",
        "audit:surface": "scripts/audit-public-surface.sh",
        "audit:tests": "scripts/audit-test-topology.sh",
        "benchmark:c-host": "cmake --preset default && cmake --build --preset default --parallel && ctest --preset benchmark",
        "benchmark:swift-macos": "CLANG_MODULE_CACHE_PATH=build/swift-module-cache swift run --disable-sandbox -c release TexCoreBenchmarks",
        "benchmark:kotlin-jvm": "scripts/gradle.sh :packages:kotlin-tex-core:kotlinBenchmark",
        "benchmark:es-node": "pnpm --filter @nouprax/es-tex-core benchmark",
        "build:c": "cmake --preset default && cmake --build --preset default --parallel",
        "build:swift": "swift build",
        "check:contracts": "node scripts/check-render-tree-fixtures.mjs",
        "check:gradle-model": "scripts/gradle-model-smoke.sh",
        "check:kotlin-consumers": "scripts/check-kotlin-consumers.sh",
        "conformance:c-host": "cmake --preset default && cmake --build --preset default --parallel && ctest --preset conformance",
        "conformance:swift-macos": "CLANG_MODULE_CACHE_PATH=build/swift-module-cache swift test --disable-sandbox --filter '^TexCoreConformanceTests\\.'",
        "conformance:swift-ios-simulator": "CLANG_MODULE_CACHE_PATH=build/swift-module-cache xcodebuild test -scheme swift-tex-core-Package -destination 'platform=iOS Simulator,name=iPhone 17 Pro,OS=latest' -derivedDataPath build/xcode-tests -only-testing:TexCoreConformanceTests",
        "conformance:kotlin-jvm": "scripts/gradle.sh :packages:kotlin-tex-core:jvmConformanceTest",
        "conformance:kotlin-android-host": "scripts/gradle.sh :packages:kotlin-tex-core:androidHostConformanceTest",
        "conformance:kotlin-android-emulator": "scripts/gradle.sh :packages:kotlin-tex-core:texCoreApi36Page4kAndroidDeviceTest :packages:kotlin-tex-core:texCoreApi36Page16kAndroidDeviceTest",
        "conformance:kotlin-macos-arm64": "scripts/gradle.sh :packages:kotlin-tex-core:macosArm64ConformanceTest",
        "conformance:kotlin-linux-x64": "scripts/gradle.sh :packages:kotlin-tex-core:linuxX64ConformanceTest",
        "conformance:es-node": "pnpm --filter @nouprax/es-tex-core conformance",
        "format": "pnpm run format:c && pnpm run format:cmake && pnpm run format:swift && pnpm run format:kotlin && pnpm run format:es",
        "format:check": "pnpm run format:c:check && pnpm run format:cmake:check && pnpm run format:swift:check && pnpm run format:kotlin:check && pnpm run format:es:check",
        "format:c": "scripts/format-c.sh",
        "format:c:check": "scripts/format-c.sh --check",
        "format:cmake": "scripts/format-cmake.sh",
        "format:cmake:check": "scripts/format-cmake.sh --check",
        "format:es": "prettier --write .",
        "format:es:check": "prettier --check .",
        "format:kotlin": "scripts/gradle.sh ktlintFormat",
        "format:kotlin:check": "scripts/gradle.sh ktlintCheck",
        "format:swift": "scripts/format-swift.sh",
        "format:swift:check": "scripts/format-swift.sh --check",
        "lint": "pnpm run lint:c && pnpm run lint:swift && pnpm run lint:kotlin && pnpm run lint:es",
        "lint:c": "scripts/lint-c.sh",
        "lint:es": "eslint .",
        "lint:kotlin": "scripts/gradle.sh ktlintCheck",
        "lint:swift": "scripts/lint-swift.sh",
        "release:check-version": "node scripts/check-release-version.mjs",
        "release:dry-run": "scripts/release-dry-run.sh",
        "test:c-host": "cmake --preset default && cmake --build --preset default --parallel && ctest --preset correctness",
        "test:swift-macos": "CLANG_MODULE_CACHE_PATH=build/swift-module-cache swift test --disable-sandbox --filter '^TexCoreTests\\.' && CLANG_MODULE_CACHE_PATH=build/swift-module-cache swift test --disable-sandbox --package-path packages/swift-tex-core/Tests/Consumer",
        "test:swift-ios-simulator": "CLANG_MODULE_CACHE_PATH=build/swift-module-cache xcodebuild test -scheme swift-tex-core-Package -destination 'platform=iOS Simulator,name=iPhone 17 Pro,OS=latest' -derivedDataPath build/xcode-tests -only-testing:TexCoreTests",
        "test:kotlin-jvm": "scripts/gradle.sh :packages:kotlin-tex-core:jvmTest",
        "test:kotlin-android-host": "scripts/gradle.sh :packages:kotlin-tex-core:testAndroidHostTest",
        "test:kotlin-android-emulator": "scripts/gradle.sh :packages:kotlin-tex-core:texCoreApi36Page4kAndroidDeviceTest :packages:kotlin-tex-core:texCoreApi36Page16kAndroidDeviceTest",
        "test:kotlin-macos-arm64": "scripts/gradle.sh :packages:kotlin-tex-core:macosArm64Test",
        "test:kotlin-linux-x64": "scripts/gradle.sh :packages:kotlin-tex-core:linuxX64Test",
        "test:es-node": "pnpm --filter @nouprax/es-tex-core test",
        "test:es-browser": "pnpm --filter @nouprax/es-tex-core test:browser",
        "verify": "pnpm run format:check && pnpm run lint && pnpm run check:contracts && pnpm run check:gradle-model && pnpm run release:check-version && pnpm run audit:repository && pnpm run audit:ci && pnpm run audit:tests && pnpm run audit:surface && pnpm run audit:packages",
        "clean:kotlin-android-emulator": "scripts/gradle.sh :packages:kotlin-tex-core:cleanManagedDevices",
        "build:es": "pnpm --filter @nouprax/es-tex-core build"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "eslint": "10.0.1",
        "prettier": "3.9.5",
        "typescript": "6.0.3",
        "typescript-eslint": "8.63.0"
    }
}
